PORT=3000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_local_secret
JWT_EXPIRES_IN=1h

# React dev origin allowed by CORS (Vite default)
CLIENT_URL=http://localhost:5173

# --- OAuth 2.0 / OpenID Connect (optional, used to accept provider access tokens) ---
# Example values are for Google; replace with your provider's values.
OAUTH_ISSUER=https://accounts.google.com
OAUTH_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
OAUTH_AUDIENCE=your_oauth_client_id
OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Optional: the account registered with this email receives the admin role.
ADMIN_EMAIL=admin@example.com
